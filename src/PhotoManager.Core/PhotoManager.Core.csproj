<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PhotoManager.Core</AssemblyName>
    <RootNamespace>PhotoManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MTP / PTP (aparaty, telefony) przez Windows Portable Devices -->
    <PackageReference Include="MediaDevices" Version="1.10.0" />
    <!-- Odczyt EXIF (data wykonania, model aparatu) -->
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
  </ItemGroup>

</Project>
