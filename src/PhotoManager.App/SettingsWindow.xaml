<Window x:Class="PhotoManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PhotoManager.App.Localization"
        Title="{loc:T Settings_Title}" Height="560" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ============ GENERAL ============ -->
            <TabItem Header="{loc:T Settings_TabGeneral}">
                <StackPanel Margin="12">
                    <TextBlock Text="{loc:T Settings_DefaultLibrary}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="DestBox" VerticalAlignment="Center" />
                        <Button  Grid.Column="1" Content="{loc:T Common_Change}" Padding="10,3" Margin="8,0,0,0" Click="ChangeDest_Click" />
                    </Grid>

                    <TextBlock Text="{loc:T Settings_FolderPattern}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="PatternBox" Margin="0,0,0,4" TextChanged="Pattern_Changed" />
                    <TextBlock x:Name="PreviewText" Foreground="#2E7D32" Margin="0,0,0,12" />

                    <TextBlock Text="{loc:T Settings_DefaultMode}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="CopyRadio" Content="{loc:T Common_Copy}" IsChecked="True" Margin="0,0,16,0" />
                        <RadioButton x:Name="MoveRadio" Content="{loc:T Common_Move}" />
                    </StackPanel>

                    <TextBlock Text="{loc:T Settings_OnDetect}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="OnDetectCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="{loc:T Settings_OnDetect_Preview}" />
                        <ComboBoxItem Content="{loc:T Settings_OnDetect_Auto}" />
                        <ComboBoxItem Content="{loc:T Settings_OnDetect_Notify}" />
                    </ComboBox>

                    <TextBlock Text="{loc:T Settings_Language}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="LanguageCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="{loc:T Settings_Language_Auto}" />
                        <ComboBoxItem Content="Polski" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>

                    <CheckBox x:Name="VerifyCheck"  Content="{loc:T Settings_Verify}" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartupCheck" Content="{loc:T Settings_Startup}" />
                </StackPanel>
            </TabItem>

            <!-- ============ EXTENSIONS ============ -->
            <TabItem Header="{loc:T Settings_TabExtensions}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{loc:T Settings_ExtHint}" />
                    <TextBox Grid.Row="1" x:Name="ExtBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <Button  Grid.Row="2" Content="{loc:T Settings_ExtReset}" HorizontalAlignment="Left"
                             Padding="10,3" Margin="0,8,0,0" Click="ResetExt_Click" />
                </Grid>
            </TabItem>

            <!-- ============ DEVICES ============ -->
            <TabItem Header="{loc:T Settings_TabDevices}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{loc:T Settings_DevHint}" />
                    <DataGrid Grid.Row="1" x:Name="DevicesGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Settings_DevCol_Device}"      Binding="{Binding DisplayName}"   Width="*"   IsReadOnly="True" />
                            <DataGridTextColumn Header="{loc:T Settings_DevCol_Destination}" Binding="{Binding Destination}"   Width="2*" />
                            <DataGridTextColumn Header="{loc:T Settings_DevCol_Pattern}"     Binding="{Binding FolderPattern}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="{loc:T Settings_RemoveDevice}" HorizontalAlignment="Left"
                            Padding="10,3" Margin="0,8,0,0" Click="RemoveDevice_Click" />
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T Btn_Save}" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="{loc:T Btn_Cancel2}" Padding="14,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
