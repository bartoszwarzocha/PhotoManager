<Window x:Class="PhotoManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia — PhotoManager" Height="520" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ============ OGÓLNE ============ -->
            <TabItem Header="Ogólne">
                <StackPanel Margin="12">
                    <TextBlock Text="Domyślny folder biblioteki" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="DestBox" VerticalAlignment="Center" />
                        <Button  Grid.Column="1" Content="Zmień…" Padding="10,3" Margin="8,0,0,0" Click="ChangeDest_Click" />
                    </Grid>

                    <TextBlock Text="Układ podfolderów (z daty wykonania)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="PatternBox" Margin="0,0,0,4" TextChanged="Pattern_Changed" />
                    <TextBlock x:Name="PreviewText" Foreground="#2E7D32" Margin="0,0,0,12" />

                    <TextBlock Text="Domyślny tryb importu" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="CopyRadio" Content="Kopiuj" IsChecked="True" Margin="0,0,16,0" />
                        <RadioButton x:Name="MoveRadio" Content="Przenieś" />
                    </StackPanel>

                    <TextBlock Text="Po wykryciu karty aparatu" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="OnDetectCombo" Width="360" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="Otwórz okno podglądu (zaznaczam sam)" />
                        <ComboBoxItem Content="Importuj automatycznie (wg profilu)" />
                        <ComboBoxItem Content="Tylko powiadom (dymek)" />
                    </ComboBox>

                    <CheckBox x:Name="VerifyCheck"  Content="Weryfikuj kopię skrótem (zalecane)" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartupCheck" Content="Uruchamiaj przy starcie Windows" />
                </StackPanel>
            </TabItem>

            <!-- ============ ROZSZERZENIA ============ -->
            <TabItem Header="Rozszerzenia">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Rozszerzenia importowanych plików — po jednym w linii lub oddzielone spacją. Kropka opcjonalna." />
                    <TextBox Grid.Row="1" x:Name="ExtBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <Button  Grid.Row="2" Content="Przywróć domyślne" HorizontalAlignment="Left"
                             Padding="10,3" Margin="0,8,0,0" Click="ResetExt_Click" />
                </Grid>
            </TabItem>

            <!-- ============ URZĄDZENIA ============ -->
            <TabItem Header="Urządzenia">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Zapamiętane urządzenia. Folder i wzorzec możesz edytować bezpośrednio w tabeli; puste = wartość domyślna." />
                    <DataGrid Grid.Row="1" x:Name="DevicesGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Urządzenie"      Binding="{Binding DisplayName}"   Width="*"   IsReadOnly="True" />
                            <DataGridTextColumn Header="Folder docelowy" Binding="{Binding Destination}"   Width="2*" />
                            <DataGridTextColumn Header="Wzorzec"         Binding="{Binding FolderPattern}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="Usuń zaznaczone" HorizontalAlignment="Left"
                            Padding="10,3" Margin="0,8,0,0" Click="RemoveDevice_Click" />
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zapisz" Padding="16,4" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Anuluj" Padding="14,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
