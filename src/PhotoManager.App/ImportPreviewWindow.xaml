<Window x:Class="PhotoManager.App.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import zdjęć" Height="760" Width="1020" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Wybór źródła (obsługa wielu kart naraz) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Źródło:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SourceCombo" MinWidth="280" DisplayMemberPath="Name"
                          SelectionChanged="SourceCombo_SelectionChanged" />
            </StackPanel>
            <TextBlock x:Name="SourceText" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Cel + tryb -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Folder docelowy:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox   Grid.Column="1" x:Name="DestBox" VerticalAlignment="Center" />
            <Button    Grid.Column="2" Content="Zmień…" Margin="8,0,0,0" Padding="10,3" Click="ChangeDest_Click" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="CopyRadio" Content="Kopiuj" IsChecked="True" Margin="0,0,10,0" />
                <RadioButton x:Name="MoveRadio" Content="Przenieś" />
            </StackPanel>
        </Grid>

        <!-- Lista plików + panel podglądu -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
            <WrapPanel x:Name="ExtFilterPanel" DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="Collapsed" />
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      IsReadOnly="False" SelectionMode="Extended"
                      SelectionChanged="FilesGrid_SelectionChanged"
                      MouseDoubleClick="FilesGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Import" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nazwa"   Binding="{Binding FileName}"    Width="*"   IsReadOnly="True" />
                    <DataGridTextColumn Header="Data"    Binding="{Binding DateDisplay}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="Rozmiar" Binding="{Binding SizeDisplay}" Width="90"  IsReadOnly="True" />
                    <DataGridTextColumn Header="Status"  Binding="{Binding Status}"      Width="120" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Panel podglądu -->
            <Border Grid.Column="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="3" Padding="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="210" Background="#0F000000" CornerRadius="2">
                        <Grid>
                            <TextBlock x:Name="PreviewHint" Text="Zaznacz zdjęcie, aby zobaczyć podgląd"
                                       Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewName" DockPanel.Dock="Top" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="2,8,2,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="Gray" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Pasek postępu + status -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="Progress" Height="18" Minimum="0" Maximum="100" />
            <TextBlock   Grid.Column="1" x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Przyciski -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="SelectionInfo" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,16,0" />
            <Button x:Name="CancelButton" Content="Przerwij" Padding="10,4" Margin="0,0,8,0"
                    Click="Cancel_Click" IsEnabled="False" />
            <Button Content="Zaznacz nowe" Padding="10,4" Margin="0,0,8,0" Click="SelectNew_Click" />
            <Button x:Name="ImportButton" Content="Importuj zaznaczone" Padding="14,4" Margin="0,0,8,0"
                    Click="Import_Click" IsEnabled="False" />
            <Button x:Name="CloseButton" Content="Zamknij" Padding="12,4" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
